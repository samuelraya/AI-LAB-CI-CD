# Admin edits this file, then runs the scripts:
#   sudo bash 1-create-project.sh project.env
#   sudo bash 2-create-service.sh project.env
#   sudo bash 3-install-runner.sh project.env
# Copy it per project (e.g. project1.env, project2.env).

# Project name: lowercase letters, digits, '-'. Gives group grp_<PROJECT>, folder /srv/projects/<PROJECT>.
PROJECT=deployment

# Linux users to add to the group, space separated.
MEMBERS="pankaj.singla@coforge.com"

# Port the application listens on (1024-65535, unique per project).
PORT=8001

# Optional extra ports (up to 3 in total), e.g. backend API or admin UI. Unique on the VM; leave empty if unused.
PORT_2=8002
PORT_3=

# Optional: Ubuntu packages the app needs to build/run (installed VM-wide by script 2).
# Python + Node example: PACKAGES="python3-venv nodejs npm"
PACKAGES=""

# GitHub repository of the project.
REPO_URL=https://github.com/pankaj-singla-coforge/AI-LAB-Dashboard
